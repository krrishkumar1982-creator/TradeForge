# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MARKET_DATA_API_KEY: Optional API key for external institutional market data providers.
# Compatible with Twelve Data, Finnhub, Polygon.io, and Alpha Vantage.
MARKET_DATA_API_KEY=""

# MARKET_DATA_PROVIDER: Primary provider selector ("twelvedata", "finnhub", "polygon", "binance", or "auto").
# When left blank or set to "auto", high-precision LBMA physical spot gold and spot market feeds are used.
MARKET_DATA_PROVIDER="auto"

# SUPABASE CONFIGURATION
# Supabase project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_URL="https://your-project.supabase.co"

# Supabase Public Anon Key (safe for client side)
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_ANON_KEY="your-anon-key"

# Supabase PostgreSQL Connection String (Transaction Pooler or Direct)
# e.g. postgresql://postgres.projectref:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:password@db.projectref.supabase.co:5432/postgres?sslmode=require"
SUPABASE_DATABASE_URL="postgresql://postgres:password@db.projectref.supabase.co:5432/postgres?sslmode=require"

# Supabase Service Role Key (Backend server-side only, never in client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
